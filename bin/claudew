#!/usr/bin/env bash
# Work-profile Claude Code launcher for the terminal and T3 Code. It runs the
# work profile (~/.claude-work) and authenticates with a one-year token from
# `command claude setup-token`, stored as CLAUDE_CODE_OAUTH_TOKEN in
# ~/.agents/claudew-token.env, so sessions never depend on a refreshable login.
# Token sessions can't use claude.ai connectors or Remote Control.
# Auto-update stays off because every profile shares one version store; two
# updaters installing the same version race and corrupt the install.
token_file="$HOME/.agents/claudew-token.env"
if [[ ! -r "$token_file" ]]; then
  echo "claudew: $token_file is missing; run 'command claude setup-token' with the work account and store it as CLAUDE_CODE_OAUTH_TOKEN=<token>" >&2
  exit 1
fi
source "$HOME/.agents/shell/agent-wrappers.sh"
set -a; source "$token_file"; set +a
CLAUDE_CONFIG_DIR="$HOME/.claude-work" DISABLE_AUTOUPDATER=1 _patched_claude "$@"
