#!/usr/bin/env bash
# Personal-profile Claude Code launcher for the terminal (the `claude` shell
# function) and T3 Code. It authenticates with a one-year token from
# `command claude setup-token`, stored as CLAUDE_CODE_OAUTH_TOKEN in
# ~/.agents/claude-token.env, so sessions never depend on a refreshable login.
# Token sessions can't use claude.ai connectors or Remote Control.
# CLAUDE_CONFIG_DIR stays unset: Claude Code keys its macOS Keychain entry on
# whether the variable is set, so setting it even to the default ~/.claude would
# split state from tools that launch `claude` bare.
# Auto-update stays off because every profile shares one version store; two
# updaters installing the same version race and corrupt the install.
token_file="$HOME/.agents/claude-token.env"
if [[ ! -r "$token_file" ]]; then
  echo "claude-token: $token_file is missing; run 'command claude setup-token' with the personal account and store it as CLAUDE_CODE_OAUTH_TOKEN=<token>" >&2
  exit 1
fi
source "$HOME/.agents/shell/agent-wrappers.sh"
set -a; source "$token_file"; set +a
DISABLE_AUTOUPDATER=1 _patched_claude "$@"
