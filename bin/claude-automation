#!/usr/bin/env bash
# Claude Code launcher for scheduled T3 threads. It authenticates with the
# one-year token from `claude setup-token`, stored as CLAUDE_CODE_OAUTH_TOKEN
# in ~/.agents/claude-token.env, so unattended runs never depend on the
# refreshable login that interactive sessions rotate and can lose. Token
# sessions can't use claude.ai connectors or Remote Control.
# Auto-update stays off because every profile shares one version store; two
# updaters installing the same version race and corrupt the install.
token_file="$HOME/.agents/claude-token.env"
if [[ ! -r "$token_file" ]]; then
  echo "claude-automation: $token_file is missing; run 'claude setup-token' and store it as CLAUDE_CODE_OAUTH_TOKEN=<token>" >&2
  exit 1
fi
source "$HOME/.agents/shell/agent-wrappers.sh"
set -a; source "$token_file"; set +a
DISABLE_AUTOUPDATER=1 _patched_claude "$@"
