<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.akelly.t3-phone-builds</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>-s</string>
		<string>/opt/homebrew/bin/uv</string>
		<string>run</string>
		<string>--quiet</string>
		<string>/Users/akelly/.agents/macos/t3-phone-builds.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/akelly/Library/Application Support/t3-phone-builds/launchd.stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Users/akelly/Library/Application Support/t3-phone-builds/launchd.stdout.log</string>
	<key>StartInterval</key>
	<integer>1800</integer>
</dict>
</plist>
