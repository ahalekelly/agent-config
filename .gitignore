# Everything is tracked by default except dependencies, runtime state, and
# machine-local files. home/ and home-windows/ are the exception: the live
# agent runtime dirs (~/.claude etc.) symlink or junction into them, so each
# has its own allowlist .gitignore — only curated config is tracked there.
.DS_Store
secrets.env
web-bot-auth/private.pem
node_modules/
*.log

# Runtime state agents create when running inside this repo's folders.
.claude/
/.codex/
.cc-writes/
.agents/
sessions/
.playwright-mcp/

# Python runtime caches for the product-search helpers.
.pytest_cache/
.ruff_cache/
skills/product-search/**/__pycache__/

# Claude Code sandbox masks these names in the cwd with /dev/null devices
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.ripgreprc
/.mcp.json
/.idea
/.vscode
