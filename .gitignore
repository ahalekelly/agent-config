# Everything is tracked by default except dependencies, runtime state, and
# machine-local files. home/ is the exception: it holds the live agent runtime
# dirs (~/.claude etc. symlink into it) and has its own allowlist .gitignore —
# only curated config is tracked there.
.DS_Store
secrets.env
node_modules/
*.log

# Runtime state agents create when running inside this repo's folders.
.claude/
!/home-windows/.claude/
.cc-writes/
.agents/
.playwright-mcp/
/playwright-mcp/shared-browser-profile/
